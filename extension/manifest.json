{
  "manifest_version": 3,
  "name": "Brightspace Canvas Wrapper",
  "version": "0.7.0",
  "description": "A Canvas-style, read-only view of Brightspace: dashboard, calendar, and per-course home, modules, assignments, quizzes, discussions, grades, announcements, files, syllabus and people.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.brightspace.com/*", "https://www.gradescope.com/*"],
  "content_scripts": [
    {
      "matches": ["https://*.brightspace.com/d2l/*"],
      "exclude_matches": ["https://*.brightspace.com/d2l/api/*"],
      "js": [
        "src/client.js",
        "src/data.js",
        "src/gradescope.js",
        "src/styles.js",
        "src/icons.js",
        "src/ui-core.js",
        "src/ui-dashboard.js",
        "src/ui-course.js",
        "src/ui-calendar.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "Run Brightspace access probe" },
  "background": { "scripts": ["background.js"], "service_worker": "background.js" },
  "browser_specific_settings": { "gecko": { "id": "brightspace-canvas-wrapper@local", "strict_min_version": "121.0", "data_collection_permissions": { "required": ["none"] } } }
}
